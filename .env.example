# ============================================
# Wayfinder Supply Co. Environment Variables
# ============================================
#
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Snapshot Cluster (for data loading)
# ============================================
# Use these credentials when loading data and creating snapshots
# This may be a different cluster than your demo cluster

SNAPSHOT_ELASTICSEARCH_URL=https://source-cluster.es.cloud:443
SNAPSHOT_ELASTICSEARCH_APIKEY=your-snapshot-api-key-here

# ============================================
# Standalone Demo Cluster
# ============================================
# Use these credentials when running the demo
# This cluster should have the snapshot restored

STANDALONE_ELASTICSEARCH_URL=https://demo-cluster.es.cloud:443
STANDALONE_ELASTICSEARCH_APIKEY=your-demo-api-key-here
STANDALONE_KIBANA_URL=https://demo-cluster.kb.cloud:443

# ============================================
# MS Build 2026 — Observability Project (OTel traces)
# ============================================
# Separate Serverless Observability project for otel-traces-wayfinder index.
# Create at cloud.elastic.co → New Project → Observability → gcp-us-central1

OBSERVABILITY_ELASTIC_URL=https://your-o11y-project.es.us-central1.gcp.elastic.cloud
OBSERVABILITY_ELASTIC_APIKEY=your-o11y-api-key-here
OBSERVABILITY_KIBANA_URL=https://your-o11y-project.kb.us-central1.gcp.elastic.cloud

# Used by scripts/index_traces.py and scripts/verify_esql_search.py:
ELASTIC_URL=https://your-o11y-project.es.us-central1.gcp.elastic.cloud
ELASTIC_API_KEY=your-o11y-api-key-here

# ============================================
# GCS Configuration (for image upload)
# ============================================
# Only needed if you're generating new products with images
# See README.md for GCP bucket setup instructions

GCS_BUCKET_NAME=wayfinder_supply_co
GCS_PREFIX=products/
GCS_SERVICE_ACCOUNT_KEY=~/wayfinder_supply_co_bucket_key.json

# ============================================
# Google AI (for product generation)
# ============================================
# Only needed if generating new products

GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
